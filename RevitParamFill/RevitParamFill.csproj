<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RevitParamFill</AssemblyName>
    <RootNamespace>RevitParamFill</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>11.0</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>EMASY</Product>
    <Company>EMASY</Company>
    <Description>Rellena parámetros desde datos del modelo, valores fijos, sectores (trazo o DWG) y deducción.</Description>
    <OutputPath>bin\$(Configuration)\EMASY-Rellenar-2024\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;installer/**;tools/**</DefaultItemExcludes>
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- El instalador es un proyecto aparte. -->
    <Compile Remove="installer\**" />
    <EmbeddedResource Remove="installer\**" />
    <None Remove="installer\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lectura de textos de DWG: se reutiliza el código de EMASY DWG Tools. -->
    <Compile Include="..\RevitDwgExploder\src\Commands\DwgTextImporter.cs" Link="Dwg\DwgTextImporter.cs" />
    <Compile Include="..\RevitDwgExploder\src\Commands\CadTextCollector.cs" Link="Dwg\CadTextCollector.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensamblados de referencia de Revit 2024 (no se copian a la salida). -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.60" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.60" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="ACadSharp">
      <HintPath>..\RevitDwgExploder\lib\ACadSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\RevitDwgExploder\lib\System.*.dll" CopyToOutputDirectory="PreserveNewest" Link="%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources\fill32.b64" LogicalName="RevitParamFill.fill32.b64" />
    <EmbeddedResource Include="resources\fill16.b64" LogicalName="RevitParamFill.fill16.b64" />
  </ItemGroup>

</Project>
