<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RevitDwgExploder</AssemblyName>
    <RootNamespace>RevitDwgExploder</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>11.0</LangVersion>
    <Nullable>disable</Nullable>
    <Version>1.16.0</Version>
    <AssemblyVersion>1.16.0.0</AssemblyVersion>
    <FileVersion>1.16.0.0</FileVersion>
    <Product>EMASY</Product>
    <Company>EMASY</Company>
    <Description>Explota DWGs importados/vinculados en Revit preservando escala, texto y estilos de línea.</Description>
    <OutputPath>bin\$(Configuration)\EMASY-2024\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;installer/**;tools/**</DefaultItemExcludes>
    <!-- ACadSharp y PdfPig piden versiones distintas de System.Memory & co.: App resuelve cualquiera desde la carpeta del addin. -->
    <MSBuildWarningsAsMessages>$(MSBuildWarningsAsMessages);MSB3277</MSBuildWarningsAsMessages>
  </PropertyGroup>

  <ItemGroup>
    <!-- El instalador es un proyecto aparte. -->
    <Compile Remove="installer\**" />
    <EmbeddedResource Remove="installer\**" />
    <None Remove="installer\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensamblados de referencia de Revit 2024 (no se copian a la salida). -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.60" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.60" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <!-- Lectura de PDF (trazos, rellenos y textos). Apache 2.0. -->
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
    <Reference Include="ACadSharp">
      <HintPath>lib\ACadSharp.dll</HintPath>
    </Reference>
    <Reference Include="Tesseract">
      <HintPath>lib\Tesseract.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources\icon32.png" LogicalName="RevitDwgExploder.icon32.png" />
    <EmbeddedResource Include="resources\icon16.png" LogicalName="RevitDwgExploder.icon16.png" />
    <EmbeddedResource Include="resources\finder32.png" LogicalName="RevitDwgExploder.finder32.png" />
    <EmbeddedResource Include="resources\finder16.png" LogicalName="RevitDwgExploder.finder16.png" />
    <EmbeddedResource Include="resources\pdf32.png" LogicalName="RevitDwgExploder.pdf32.png" />
    <EmbeddedResource Include="resources\pdf16.png" LogicalName="RevitDwgExploder.pdf16.png" />
    <EmbeddedResource Include="resources\pdffinder32.png" LogicalName="RevitDwgExploder.pdffinder32.png" />
    <EmbeddedResource Include="resources\pdffinder16.png" LogicalName="RevitDwgExploder.pdffinder16.png" />
    <EmbeddedResource Include="resources\img32.png" LogicalName="RevitDwgExploder.img32.png" />
    <EmbeddedResource Include="resources\img16.png" LogicalName="RevitDwgExploder.img16.png" />
    <EmbeddedResource Include="resources\imgfinder32.png" LogicalName="RevitDwgExploder.imgfinder32.png" />
    <EmbeddedResource Include="resources\imgfinder16.png" LogicalName="RevitDwgExploder.imgfinder16.png" />
  </ItemGroup>

  <ItemGroup>
    <None Include="lib\x64\**" CopyToOutputDirectory="PreserveNewest" Link="x64\%(RecursiveDir)%(Filename)%(Extension)" />
    <None Include="lib\tessdata\**" CopyToOutputDirectory="PreserveNewest" Link="tessdata\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
