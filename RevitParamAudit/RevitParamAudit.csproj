<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>RevitParamAudit</AssemblyName>
    <RootNamespace>RevitParamAudit</RootNamespace>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>11.0</LangVersion>
    <Nullable>disable</Nullable>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <Product>EMASY</Product>
    <Company>EMASY</Company>
    <Description>Depura el modelo: planos, vistas, filtros y parámetros sin uso.</Description>
    <OutputPath>bin\$(Configuration)\EMASY-Depurador-2024\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);dist/**;installer/**;tools/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- El instalador es un proyecto aparte. -->
    <Compile Remove="installer\**" />
    <EmbeddedResource Remove="installer\**" />
    <None Remove="installer\**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Ensamblados de referencia de Revit 2024 (no se copian a la salida). -->
    <PackageReference Include="Nice3point.Revit.Api.RevitAPI" Version="2024.3.60" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Nice3point.Revit.Api.RevitAPIUI" Version="2024.3.60" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="resources\sheets32.png" LogicalName="RevitParamAudit.sheets32.png" />
    <EmbeddedResource Include="resources\sheets16.png" LogicalName="RevitParamAudit.sheets16.png" />
    <EmbeddedResource Include="resources\views32.png" LogicalName="RevitParamAudit.views32.png" />
    <EmbeddedResource Include="resources\views16.png" LogicalName="RevitParamAudit.views16.png" />
    <EmbeddedResource Include="resources\filters32.png" LogicalName="RevitParamAudit.filters32.png" />
    <EmbeddedResource Include="resources\filters16.png" LogicalName="RevitParamAudit.filters16.png" />
    <EmbeddedResource Include="resources\params32.png" LogicalName="RevitParamAudit.params32.png" />
    <EmbeddedResource Include="resources\params16.png" LogicalName="RevitParamAudit.params16.png" />
  </ItemGroup>

</Project>
